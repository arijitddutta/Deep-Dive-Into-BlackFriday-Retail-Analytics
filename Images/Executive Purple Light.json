          }
        ],
        "visualHeader": [
          {
            "background": {
              "solid": {
                "color": "#231f28"
              }
            },
            "border": {
              "solid": {
                "color": "#231f28"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#080212"
              }
            }
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#ffffff"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#000000"
              }
            }
          }
        ],
        "background": [
          {
            "color": {
              "solid": {
                "color": "#442c68"
              }
            },
            "transparency": 0
          }
        ],
        "filterCard": [
          {
